DISCORD_TOKEN=
BOT_NAME=AtyroCloud
PREFIX=!
YOUR_SERVER_IP=127.0.0.1
MAIN_ADMIN_ID=1210291131301101618
VPS_USER_ROLE_ID=1210291131301101618
DEFAULT_STORAGE_POOL=default
BOT_VERSION=8.0-PRO
BOT_DEVELOPER=Hopingboyz
BOT_THUMBNAIL_URL=https://i.imgur.com/xAx2gRQ.jpeg
BOT_ICON_URL=https://i.imgur.com/xAx2gRQ.jpeg
DEFAULT_VPS_EXPIRATION_DAYS=30
EXPIRATION_WARNING_DAYS=3
HOST_MOTD=bash <(curl -fsSL https://raw.githubusercontent.com/hopingboyz/linux/main/atyro-water-mark.sh)

# Public VPS Creation Settings (for !vps create command)
PUBLIC_VPS_ENABLED=true
PUBLIC_VPS_MAX_RAM=8
PUBLIC_VPS_MAX_CPU=2
PUBLIC_VPS_MAX_DISK=40
PUBLIC_VPS_EXPIRY_DAYS=3
PUBLIC_VPS_MAX_PER_USER=1
PUBLIC_VPS_MAX_PER_IP=1
PUBLIC_VPS_REQUIRE_VERIFICATION=false
PUBLIC_VPS_GLOBAL_LIMIT=100

# Public VPS Renewal Settings (for !vps renew command)
PUBLIC_VPS_RENEWAL_ENABLED=true
PUBLIC_VPS_RENEWAL_DAYS=3

# Rate Limiting Settings (prevent spam/abuse)
RATE_LIMIT_COOLDOWN=2
RATE_LIMIT_BURST=5
RATE_LIMIT_MAX_VIOLATIONS=5
RATE_LIMIT_ABUSE_TIMEOUT=120

# VPS Expiration Settings
EXPIRATION_AUTO_SUSPEND=true
EXPIRATION_CHECK_INTERVAL=900

# Public VPS Renewal Settings (for !vps renew command)
PUBLIC_VPS_RENEWAL_WINDOW_DAYS=1
PUBLIC_VPS_COOLDOWN_HOURS=24
PUBLIC_VPS_REQUIRE_ACCOUNT_AGE=3

# Web SSH Terminal Settings
WEBSSH_HOST=0.0.0.0
WEBSSH_PORT=5000
WEBSSH_SERVER_IP=127.0.0.1
WEBSSH_URL_FORMAT=http://{SERVER_IP}:{PORT}
WEBSSH_SESSION_TTL=1800
WEBSSH_MAX_SESSIONS=200
WEBSSH_SESSION_MAX_PER_IP=8
WEBSSH_ALLOW_PRIVATE_HOSTS=true
WEBSSH_DEFAULT_PIN=false
WEBSSH_PIN_ATTEMPTS=5
WEBSSH_CONNECT_TIMEOUT=15

# Command Timeouts
LXC_TIMEOUT_DEFAULT=180
COMMAND_TIMEOUT_SECONDS=240
MANAGE_PANEL_TIMEOUT=300
CONSOLE_PANEL_TIMEOUT=600
STATS_REFRESH_SECONDS=5
MAX_LIVE_REFRESHES=60

# Owner IDs (Discord user IDs for bot owner, comma-separated or leave empty to use MAIN_ADMIN_ID)
OWNER_IDS=
